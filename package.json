{
  "name": "folio-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet, local PDF reading room.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/build.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux tar.gz --x64",
    "test:desktop": "npm run build && node tests/desktop.browser.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.61.1",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "desktop/main.mjs"
}
